{
  "$defs": {
    "AdmissionType": {
      "enum": [
        "planned_surgical",
        "day_care",
        "emergency",
        "maternity"
      ],
      "title": "AdmissionType",
      "type": "string"
    },
    "PatientGender": {
      "enum": [
        "M",
        "F",
        "O"
      ],
      "title": "PatientGender",
      "type": "string"
    },
    "RoomCategory": {
      "enum": [
        "general",
        "shared",
        "single",
        "deluxe"
      ],
      "title": "RoomCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9-]{8,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "policy_number": {
      "pattern": "^[A-Z0-9][A-Z0-9-]{5,31}$",
      "title": "Policy Number",
      "type": "string"
    },
    "policy_issue_date": {
      "format": "date",
      "title": "Policy Issue Date",
      "type": "string"
    },
    "policy_start_date": {
      "format": "date",
      "title": "Policy Start Date",
      "type": "string"
    },
    "sum_insured": {
      "maximum": 10000000,
      "minimum": 100000,
      "multipleOf": 1000,
      "title": "Sum Insured",
      "type": "integer"
    },
    "patient_age": {
      "maximum": 100,
      "minimum": 0,
      "title": "Patient Age",
      "type": "integer"
    },
    "patient_gender": {
      "$ref": "#/$defs/PatientGender"
    },
    "admission_type": {
      "$ref": "#/$defs/AdmissionType"
    },
    "planned_admission_date": {
      "format": "date",
      "title": "Planned Admission Date",
      "type": "string"
    },
    "diagnosis_text": {
      "maxLength": 500,
      "minLength": 3,
      "title": "Diagnosis Text",
      "type": "string"
    },
    "procedure_text": {
      "maxLength": 300,
      "minLength": 3,
      "title": "Procedure Text",
      "type": "string"
    },
    "procedure_code": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9.-]{2,20}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Procedure Code"
    },
    "room_category_requested": {
      "$ref": "#/$defs/RoomCategory"
    },
    "estimated_cost": {
      "exclusiveMinimum": 0.0,
      "maximum": 5000000.0,
      "title": "Estimated Cost",
      "type": "number"
    },
    "hospital_id": {
      "pattern": "^SYN-HOSP-[A-Z0-9-]{2,24}$",
      "title": "Hospital Id",
      "type": "string"
    },
    "prior_conditions": {
      "items": {
        "maxLength": 100,
        "minLength": 3,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Prior Conditions",
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "policy_number",
    "policy_issue_date",
    "policy_start_date",
    "sum_insured",
    "patient_age",
    "patient_gender",
    "admission_type",
    "planned_admission_date",
    "diagnosis_text",
    "procedure_text",
    "room_category_requested",
    "estimated_cost",
    "hospital_id"
  ],
  "title": "PreauthRequest",
  "type": "object"
}
