# ==============================================================================
# Environment Configuration - Health Insurance Pre-Authorisation Desk
# Safe placeholders only. Copy to .env and configure for local runtime.
# NEVER commit .env to source control.
# ==============================================================================

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Service Network Config
API_HOST=0.0.0.0
API_PORT=8000
WORKER_CONCURRENCY=5

# Databases and Queues
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/preauth_db
REDIS_URL=redis://redis:6379/0
POSTGRES_DB=preauth_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# LLM Provider Configuration
# Providers: stub | ollama | gemini | groq | openrouter | openai
LLM_PROVIDER=stub
LLM_API_KEY=your_llm_api_key_or_ollama_placeholder
LLM_MODEL=your_llm_model_name_here
LLM_BASE_URL=http://llm-stub:8080

# Stub & Resilience Testing
STUB_DELAY_MS=250
STUB_JITTER_MS=50
# FAULT_MODE: none | provider_down | slow | garbage
FAULT_MODE=none
DEMO_FORCE_BAD_CITATION=0

# Loop & Execution Bounds
MAX_STEPS=12
MAX_TOOL_CALLS=10
RUN_TIMEOUT_S=90
LLM_TIMEOUT_S=20
TOOL_TIMEOUT_S=5
MAX_REPLANS=2

# Circuit Breaker Config
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_S=30
LLM_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_S=0.5

# Rate Limiting & Caching
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SECOND=1.0
GUARDRAILS_ENABLED=true
ENABLE_EMBEDDING_CACHE=true
ENABLE_RETRIEVAL_CACHE=true
ENABLE_RUN_CACHE=false

# Corpus and Embeddings
CORPUS_RAW_DIR=/app/corpus/raw
INDEX_STORAGE_DIR=/app/index_data
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Observability (OpenTelemetry / Prometheus)
OTEL_ENABLED=true
OTEL_EXPORTER_ENDPOINT=http://jaeger:4317
SERVICE_NAME=preauth-desk
PROMETHEUS_METRICS_PATH=/metrics
LLM_INPUT_COST_PER_1K=0
LLM_OUTPUT_COST_PER_1K=0
